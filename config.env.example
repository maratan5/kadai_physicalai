# 必要な場合だけこのファイルを config.env にコピーして編集します。
# これらはプロジェクト内でのみ読まれ、システム設定を変更しません。
# KADAI_BEHAVIOR_REF=v3.9.3-post2
# KADAI_BEHAVIOR_DIR="$HOME/BEHAVIOR-1K"
# KADAI_CONDA_ENV=behavior
# KADAI_POLICY_HOST=127.0.0.1
# KADAI_POLICY_PORT=8000
# KADAI_POLICY_BIND=127.0.0.1
# 自然言語から公式タスクを選ぶ OpenAI API モデル（キーは ~/.bashrc から）
# KADAI_OPENAI_MODEL=gpt-4.1-mini
# KADAI_ALLOW_UNTESTED_16GB=1
# OmniGibson側では学習済みポリシーの評価に不要なLeRobotデータセット依存を省略
# KADAI_SKIP_LEROBOT=1

# 録画: 1=公式の頭部/手首映像に加えて第三者視点入り動画を保存 (既定), 0=公式映像のみ
# KADAI_OVERVIEW_VIDEO=1
# 第三者視点（既定: ロボットの斜め右後方を追従）
# KADAI_CAMERA_MODE=follow
# KADAI_CAMERA_HEIGHT=2.0
# 固定俯瞰カメラの水平オフセット。壁が映る場合は両方0に近づけてください。
# KADAI_CAMERA_OVERHEAD_X=0.40
# KADAI_CAMERA_OVERHEAD_Y=-0.35
# 追従カメラの距離と右側オフセット（m）
# KADAI_CAMERA_DISTANCE=0.9
# KADAI_CAMERA_SIDE=0.425
# 初期位置で固定の俯瞰カメラにする場合
# KADAI_CAMERA_MODE=fixed_overhead
# KADAI_OUTPUT_TZ=Asia/Tokyo

# GUIで空欄にするとタスク別の公式既定値になります。CLI/直接bashでのみこちらの既定値が使われます。
# KADAI_MAX_STEPS=500
# アクションチャンクの既定値（GUIの初期値は20）
# KADAI_ACTION_CHUNK_SIZE=20
